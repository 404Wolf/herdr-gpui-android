+
+/// herdr: how the ids of links the program gave none are written: a stable
+/// "herdr.i.N" from the screen's own counter. An explicit id with this
+/// prefix is dropped, so the two never collide. Known limit: a paint of a
+/// screen that was itself fed a herdr paint (a core relaying another) drops
+/// those received "herdr.i.N" ids too, so such a link's rows are written as
+/// separate links there; their targets are kept.
+const implicit_link_prefix = "herdr.i.";
+
+/// herdr: the id a VT hyperlink is written with.
+const VtLinkId = union(enum) {
+    none,
+    explicit: []const u8,
+    implicit: u64,
+};
+
+/// herdr: whether an explicit OSC 8 id can be written back as is: printable
+/// ASCII without the parameter separators, short, and not in the implicit
+/// ids' namespace.
+fn portableLinkId(id: []const u8) bool {
+    if (id.len == 0 or id.len > 256) return false;
+    if (std.mem.startsWith(u8, id, implicit_link_prefix)) return false;
+    for (id) |byte| {
+        if (byte <= 0x20 or byte >= 0x7f or byte == ':' or byte == ';') return false;
+    }
+    return true;
+}
+
+/// herdr: the bytes of `uri` as portable ASCII (writeVtLinkUri).
+fn encodedLinkUriLen(uri: []const u8) usize {
+    var len: usize = 0;
+    for (uri) |byte| len += if (byte > 0x20 and byte < 0x7f) 1 else 3;
+    return len;
+}
+
+/// herdr: the bytes the parameters take for `id` ("id=...", or none).
+fn linkIdParamLen(id: VtLinkId) usize {
+    return switch (id) {
+        .none => 0,
+        .explicit => |v| "id=".len + v.len,
+        .implicit => |n| "id=".len + implicit_link_prefix.len + std.fmt.count("{d}", .{n}),
+    };
+}
+
+/// herdr: an OSC 8 target as portable ASCII: bytes outside printable ASCII
+/// are percent-encoded (a raw 0x9C is ST to a C1-aware viewer), existing %XX
+/// escapes are kept as they are.
+fn writeVtLinkUri(writer: *std.Io.Writer, uri: []const u8) std.Io.Writer.Error!void {
+    for (uri) |byte| {
+        if (byte > 0x20 and byte < 0x7f) {
+            try writer.writeByte(byte);
+        } else {
+            try writer.print("%{X:0>2}", .{byte});
+        }
+    }
+}
+
+/// herdr: opens a VT hyperlink to `uri` as the program wrote it, the cells'
+/// and the cursor's alike: its id (explicit as is when portable, implicit as
+/// "herdr.i.N") and its target as portable ASCII. It must fit the parser's
+/// capture, encoded: over it, the id is left out; still over, no link is
+/// opened at all (never a cut target; the close that follows is harmless).
+fn writeVtLinkOpen(writer: *std.Io.Writer, id_in: VtLinkId, uri: []const u8) std.Io.Writer.Error!void {
+    var id = id_in;
+    switch (id) {
+        .explicit => |v| if (!portableLinkId(v)) {
+            id = .none;
+        },
+        else => {},
+    }
+    const uri_len = encodedLinkUriLen(uri);
+    if (uri.len == 0 or 1 + uri_len + 1 > max_vt_link_payload) return;
+    if (linkIdParamLen(id) + 1 + uri_len + 1 > max_vt_link_payload) id = .none;
+    try writer.writeAll("\x1b]8;");
+    switch (id) {
+        .none => {},
+        .explicit => |v| {
+            try writer.writeAll("id=");
+            try writer.writeAll(v);
+        },
+        .implicit => |n| try writer.print("id=" ++ implicit_link_prefix ++ "{d}", .{n}),
+    }
+    try writer.writeByte(';');
+    try writeVtLinkUri(writer, uri);
+    try writer.writeAll("\x1b\\");
+}
