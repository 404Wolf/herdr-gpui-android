+
+/// Desktop first: the phone leads only while the focused window is hidden or
+/// unmeasured and it was used after that window was last focused.
+#[test]
+fn a_visible_focused_desktop_wins_over_a_phone() {
+    let (core, id, root) = core_with_screen(100, 40);
+    let app = desktop_conn();
+    let phone = Arc::new(Conn::default());
+    let grid = || core.lock().screens[&id].size();
+    let local = Some(("test", "test"));
+    let p = core.attach(&phone, id, focus_request((40, 10), None, false, false)).unwrap();
+    core.viewer_resize(&phone, p, 40, 10);
+    let a = core.attach(&app, id, focus_request((120, 50), local, true, true)).unwrap();
+    core.viewer_resize(&app, a, 120, 50);
+    assert_eq!(grid(), (120, 50));
+    // Phone input while the desktop is visible and measured, focused or not.
+    core.viewer_input(&phone, p, b"x", false);
+    assert_eq!(grid(), (120, 50), "a phone never wins over a visible focused desktop");
+    core.viewer_window_focus(&app, a, false);
+    core.viewer_input(&phone, p, b"x", false);
+    assert_eq!(grid(), (120, 50), "nor over the visible last focused desktop");
+    // Hidden, but the phone was last used before the window was focused again.
+    core.viewer_window_focus(&app, a, true);
+    core.viewer_visibility(&app, a, false);
+    assert_eq!(grid(), (120, 50), "a phone idle since the last focus does not take over");
+    core.viewer_input(&phone, p, b"x", false);
+    assert_eq!(grid(), (40, 10), "a phone used since leads while the desktop is hidden");
+    core.viewer_visibility(&app, a, true);
+    core.viewer_resize(&app, a, 120, 50);
+    assert_eq!(grid(), (120, 50), "the desktop shown again wins");
+    core.viewer_input(&phone, p, b"x", false);
+    assert_eq!(grid(), (120, 50), "phone input changes nothing while it is shown");
+    drop(core);
+    std::fs::remove_dir_all(root).unwrap();
+}
