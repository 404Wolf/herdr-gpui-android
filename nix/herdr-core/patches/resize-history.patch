+fn history_request(resize_history: usize) -> AttachRequest {
+    AttachRequest {
+        observe: false,
+        resize_notifications: true,
+        visible: true,
+        visibility_updates: false,
+        focus_updates: false,
+        focused: false,
+        history: 0,
