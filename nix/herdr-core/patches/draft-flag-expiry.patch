+/// Waits until `t` has printed `needle` `n` times.
+fn shows_n(s: &Session, t: &str, needle: &str, n: usize) {
+    wait_until(&format!("{n} {needle:?} in {t}"), || text(s, t).matches(needle).count() == n);
+}
