<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Dictation in the composer; asked for on the first tap of the microphone. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Android 11+ package visibility: without this the phone's speech
         recognition services are invisible, so the dictation fallback to the
         phone's own recognizer would find none. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- Attach > Take a photo hands the shot to the phone's own camera app. -->
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <uses-feature android:name="android.hardware.vulkan.level" android:version="0" android:required="false" />
    <!-- Back reaches each screen through OnBackInvokedCallback (BackOwner) on
         Android 13 and later, as Android 16 requires for every app targeting it. -->
    <application android:label="Remote for Herdr" android:theme="@style/AppTheme"
        android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true" tools:targetApi="33"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        tools:ignore="DataExtractionRules"
        android:usesCleartextTraffic="false" android:hardwareAccelerated="true"
        android:supportsRtl="true">
        <!-- The device's fold reports (tabletop posture); absent on most phones. -->
        <uses-library android:name="androidx.window.extensions" android:required="false" />
        <!-- Home: every machine's agents as one tree. Folding only re-lays it out,
             so the background sessions survive (configChanges). -->
        <activity android:name="dev.herdr.android.HomeActivity" android:exported="true"
            android:theme="@style/GpuiTheme"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode|density|fontScale"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name="dev.herdr.android.RemoteHostsActivity" android:exported="false"
            android:theme="@style/GpuiTheme"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name="dev.herdr.android.DeviceDiagnosticsActivity" android:exported="false" />
        <!-- "Share to Herdr": images from the share sheet go to the agent on screen. -->
        <activity android:name="dev.herdr.android.ShareTargetActivity" android:exported="true"
            android:label="Herdr" android:excludeFromRecents="true" android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>
        <activity android:name="dev.herdr.android.AboutActivity" android:exported="false"
            android:theme="@style/AboutTheme" />
        <activity android:name="dev.herdr.android.GpuiTerminalActivity" android:exported="false"
            android:theme="@style/GpuiTheme"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode|density|fontScale"
            android:windowSoftInputMode="adjustResize">
            <meta-data android:name="android.app.lib_name" android:value="herdr_gpui_android" />
        </activity>
    </application>
</manifest>
